      "inTimecode": "00:00:05:02",
      "outTimecode": "00:00:16:29",
      "text": "The tests passed. That's a good start, but what's still untested? Dynamic workflows bring commands, AI agents, and review checkpoints into one reusable process.",
      "words": 24,
      "budgetSeconds": 11.899999999999999,
      "requiredWpm": 121,
