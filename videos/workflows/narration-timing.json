    {
      "id": "purpose",
      "sceneStart": 17,
      "sceneEnd": 37.8,
      "speechStart": 17.7,
      "speechEnd": 37.75,
      "inTimecode": "00:00:17:21",
      "outTimecode": "00:00:37:23",
      "text": "Here are a few examples of where dynamic workflows can help. Prepare a release with tests and a list of what's untested. Review a pull request with the checks and findings in one place. Investigate a failed build by gathering logs and possible next steps. Let's look at a simple example with a Python book app.",
      "words": 56,
      "budgetSeconds": 20.05,
      "requiredWpm": 168,
      "silentTailSeconds": 0.05000000000000071,
      "visualCue": "A few places this helps",
      "pictureTiming": [],
      "audioFile": "assets/narration/segments/purpose.wav",
      "audioAlignmentFile": "assets/narration/segments/purpose.json",
      "measuredSpeechStart": 17.699999999999996,
      "measuredSpeechEnd": 37.237142999999996,
      "audioEnd": 37.722125
    },
    {
      "id": "focus",
      "sceneStart": 37.8,
      "sceneEnd": 55.099999999999994,
      "speechStart": 38.349999999999994,
      "speechEnd": 55.05,
      "inTimecode": "00:00:38:10",
      "outTimecode": "00:00:55:02",
      "text": "Here's the plan. Run the tests first. Then, take a look at the results. Find the gaps with an AI agent. We'll save the report so we can decide what needs work. This is our own workflow, not a built-in command. Let's create book release check.",
      "words": 46,
      "budgetSeconds": 16.700000000000003,
      "requiredWpm": 165,
      "silentTailSeconds": 0.05000000000000071,
      "visualCue": "What haven't we tested yet?",
